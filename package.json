{
  "name": "live-review",
  "displayName": "Live Review",
  "description": "The repos you pick, every live Claude session with its players and the files each one changed, with a diff per file, and the workspace notes each session wrote.",
  "version": "0.2.1",
  "publisher": "visiond",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.100.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/view/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveReview",
          "title": "Live Review",
          "icon": "media/live-review.svg"
        }
      ]
    },
    "views": {
      "liveReview": [
        {
          "id": "liveReview.repos",
          "name": "Repos"
        },
        {
          "id": "liveReview.sessions",
          "name": "Sessions"
        },
        {
          "id": "liveReview.changes",
          "name": "Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "liveReview.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "liveReview.fetch",
        "title": "Fetch picked repos",
        "icon": "$(cloud-download)"
      },
      {
        "command": "liveReview.addRepo",
        "title": "Add a repo folder",
        "icon": "$(add)"
      },
      {
        "command": "liveReview.pinRepo",
        "title": "Pin to the top of its system",
        "icon": "$(pin)"
      },
      {
        "command": "liveReview.unpinRepo",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "liveReview.removeRepo",
        "title": "Remove from the list",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.clearFinished",
        "title": "Clear finished players",
        "icon": "$(clear-all)"
      },
      {
        "command": "liveReview.removeSession",
        "title": "Remove the session and its players",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.removePlayer",
        "title": "Remove the player",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.openTimeline",
        "title": "Open the player's timeline"
      },
      {
        "command": "liveReview.openDiff",
        "title": "Open the diff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "liveReview.addRepo",
          "when": "view == liveReview.repos",
          "group": "navigation@1"
        },
        {
          "command": "liveReview.fetch",
          "when": "view == liveReview.repos",
          "group": "navigation@2"
        },
        {
          "command": "liveReview.refresh",
          "when": "view == liveReview.repos",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "liveReview.pinRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\.unpinned/",
          "group": "inline@1"
        },
        {
          "command": "liveReview.unpinRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\.pinned/",
          "group": "inline@1"
        },
        {
          "command": "liveReview.removeRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\./",
          "group": "inline@2"
        },
        {
          "command": "liveReview.clearFinished",
          "when": "view == liveReview.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "liveReview.removeSession",
          "when": "view == liveReview.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "liveReview.removePlayer",
          "when": "view == liveReview.sessions && viewItem == player",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "liveReview.pinRepo",
          "when": "false"
        },
        {
          "command": "liveReview.unpinRepo",
          "when": "false"
        },
        {
          "command": "liveReview.removeRepo",
          "when": "false"
        },
        {
          "command": "liveReview.openTimeline",
          "when": "false"
        },
        {
          "command": "liveReview.openDiff",
          "when": "false"
        },
        {
          "command": "liveReview.clearFinished",
          "when": "false"
        },
        {
          "command": "liveReview.removeSession",
          "when": "false"
        },
        {
          "command": "liveReview.removePlayer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Live Review",
      "properties": {
        "liveReview.workspaceRoot": {
          "type": "string",
          "default": "~/projects/REDACTED/.claude-workspace",
          "description": "The folder that holds one notes folder per project, outside every repo. A session's Workspace files are the files saved since it started in the folders its Write and Edit calls touched here, and a player's row and job come from the ORCHESTRA.md of those folders."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  }
}
