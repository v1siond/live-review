{
  "name": "live-review",
  "displayName": "Live Review",
  "description": "The repos you pick, every live Claude session with its players and the files each one changed, with a diff per file, and the workspace notes each session wrote.",
  "version": "0.3.1",
  "publisher": "v1siond",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/v1siond/live-review.git"
  },
  "homepage": "https://github.com/v1siond/live-review#readme",
  "bugs": {
    "url": "https://github.com/v1siond/live-review/issues"
  },
  "engines": {
    "vscode": "^1.100.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "SCM Providers"
  ],
  "main": "./out/view/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "liveReview",
          "title": "Live Review",
          "icon": "media/live-review.svg"
        }
      ]
    },
    "views": {
      "liveReview": [
        {
          "id": "liveReview.repos",
          "name": "Repos"
        },
        {
          "id": "liveReview.sessions",
          "name": "Sessions"
        },
        {
          "id": "liveReview.changes",
          "name": "Changes"
        }
      ]
    },
    "commands": [
      {
        "command": "liveReview.refresh",
        "title": "Refresh",
        "icon": "$(refresh)"
      },
      {
        "command": "liveReview.fetch",
        "title": "Fetch picked repos",
        "icon": "$(cloud-download)"
      },
      {
        "command": "liveReview.addRepo",
        "title": "Add a repo folder",
        "icon": "$(add)"
      },
      {
        "command": "liveReview.pinRepo",
        "title": "Pin to the top of its system",
        "icon": "$(pin)"
      },
      {
        "command": "liveReview.unpinRepo",
        "title": "Unpin",
        "icon": "$(pinned)"
      },
      {
        "command": "liveReview.compareTo",
        "title": "Compare to a branch",
        "icon": "$(git-compare)"
      },
      {
        "command": "liveReview.removeRepo",
        "title": "Remove from the list",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.clearFinished",
        "title": "Clear finished players",
        "icon": "$(clear-all)"
      },
      {
        "command": "liveReview.removeSession",
        "title": "Remove the session and its players",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.removePlayer",
        "title": "Remove the player",
        "icon": "$(close)"
      },
      {
        "command": "liveReview.openTimeline",
        "title": "Open the player's timeline"
      },
      {
        "command": "liveReview.openDiff",
        "title": "Open the diff"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "liveReview.addRepo",
          "when": "view == liveReview.repos",
          "group": "navigation@1"
        },
        {
          "command": "liveReview.fetch",
          "when": "view == liveReview.repos",
          "group": "navigation@2"
        },
        {
          "command": "liveReview.refresh",
          "when": "view == liveReview.repos",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "liveReview.compareTo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\./",
          "group": "inline@0"
        },
        {
          "command": "liveReview.pinRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\.unpinned/",
          "group": "inline@1"
        },
        {
          "command": "liveReview.unpinRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\.pinned/",
          "group": "inline@1"
        },
        {
          "command": "liveReview.removeRepo",
          "when": "view == liveReview.repos && viewItem =~ /^repo\\./",
          "group": "inline@2"
        },
        {
          "command": "liveReview.clearFinished",
          "when": "view == liveReview.sessions && viewItem == session",
          "group": "inline@1"
        },
        {
          "command": "liveReview.removeSession",
          "when": "view == liveReview.sessions && viewItem == session",
          "group": "inline@2"
        },
        {
          "command": "liveReview.removePlayer",
          "when": "view == liveReview.sessions && viewItem == player",
          "group": "inline@1"
        }
      ],
      "commandPalette": [
        {
          "command": "liveReview.compareTo",
          "when": "false"
        },
        {
          "command": "liveReview.pinRepo",
          "when": "false"
        },
        {
          "command": "liveReview.unpinRepo",
          "when": "false"
        },
        {
          "command": "liveReview.removeRepo",
          "when": "false"
        },
        {
          "command": "liveReview.openTimeline",
          "when": "false"
        },
        {
          "command": "liveReview.openDiff",
          "when": "false"
        },
        {
          "command": "liveReview.clearFinished",
          "when": "false"
        },
        {
          "command": "liveReview.removeSession",
          "when": "false"
        },
        {
          "command": "liveReview.removePlayer",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Live Review",
      "properties": {
        "liveReview.projectsRoot": {
          "scope": "machine",
          "type": "string",
          "default": "~/projects",
          "description": "The folder scanned for git clones. A leading ~ is your home folder. Session names are shown relative to it, and a Bash call only adds repos found inside it."
        },
        "liveReview.scanDepth": {
          "scope": "machine",
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 6,
          "description": "How many folder levels under liveReview.projectsRoot are searched for a .git folder. 3 finds projects/group/repo."
        },
        "liveReview.workspaceRoot": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "Optional. A folder outside every repo that holds one notes folder per project. When set, each session lists the files saved there since it started (Workspace files), and a player whose description says \"Row <n>\" gets its row and job from the ORCHESTRA.md of those folders. Empty turns both off."
        },
        "liveReview.defaultCompareBranch": {
          "scope": "machine",
          "type": "string",
          "default": "",
          "description": "A branch every repo is compared to (for example origin/main) unless you picked something else for it with Compare to a branch. A repo where this branch does not exist keeps the HEAD comparison. Empty compares every repo to HEAD."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/vsce": "4.0.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@azure/msal-node": "7.1.0"
  }
}
